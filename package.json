{
  "name": "openspace-localhost",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 3004 --strictPort",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 3004 --strictPort",
    "docker:up": "sh scripts/docker-up.sh up --build -d",
    "docker:build": "sh scripts/docker-up.sh build",
    "docker:down": "docker compose down"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "~5.7.2",
    "vite": "^6.0.3"
  }
}
