{
  "name": "openspace-localhost",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 3004 --strictPort",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "preview": "vite preview --port 3004 --strictPort",
    "docker:up": "sh scripts/docker-up.sh up --build -d",
    "docker:dev": "sh scripts/docker-up.sh -f docker-compose.dev.yml up",
    "docker:dev:d": "sh scripts/docker-up.sh -f docker-compose.dev.yml up -d",
    "docker:build": "sh scripts/docker-up.sh build",
    "docker:down": "docker compose down",
    "docker:dev:down": "docker compose -f docker-compose.dev.yml down"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "~5.7.2",
    "vite": "^6.0.3",
    "vitest": "^3.0.5"
  }
}
